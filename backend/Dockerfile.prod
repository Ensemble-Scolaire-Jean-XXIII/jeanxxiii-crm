# ============================================================
# BACKEND — PROD (multistage TS -> JS compilé, runner léger)
# Le code tourne via `node dist/index.js` (plus nodemon/tsx).
# Image virtuelle ~265 MB (au lieu de ~368 MB), contenu réel
# ~155 MB. `public/` est copié (signature.png pour les emails).
# ============================================================
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx tsc -p . --outDir dist --rootDir .

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/package*.json ./
COPY --from=deps /app/node_modules ./node_modules
RUN npm prune --omit=dev
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public

USER node
EXPOSE 5000
CMD ["node", "dist/index.js"]